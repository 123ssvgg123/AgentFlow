# ============================================================
#  FoodAgent 环境变量模板
#  使用方式：复制本文件为 .env 并填入真实值
#      cp .env.example .env
#  【安全】.env 已在 .gitignore 中排除，不会提交到仓库
# ============================================================

# ---------- 服务器 ----------
APP_HOST=0.0.0.0
APP_PORT=8090

# ---------- DeepSeek 大模型 ----------
# 必填：DeepSeek 平台 API Key（以 sk- 开头）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 密钥名称（DeepSeek 控制台上的 key 名称，仅作标识，不参与鉴权）
LLM_API_KEY_NAME=tool
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=30
# 设为 false 可完全离线运行（所有 LLM 工具走规则引擎降级）
LLM_ENABLED=true

# ---------- PostgreSQL（长期记忆 + Checkpointer） ----------
# 开启后：短期记忆走 PostgresSaver（重启不丢对话、支持 Human-in-the-Loop 断点续传），
#         长期记忆写入 6 张业务表；PG 不可用时自动降级为 MemorySaver + JSON 文件。
# 本机部署（Docker）：docker run -d --name foodagent_postgres -p 5432:5432 \
#   -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=foodagent \
#   -v foodagent_pgdata:/var/lib/postgresql/data postgres:15-alpine
PG_ENABLED=false
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=foodagent

# ---------- Milvus（向量检索，可选） ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=foodagent

# ---------- JWT 认证 ----------
# 生产环境请改为随机长串（如 openssl rand -hex 32 生成）
JWT_SECRET=foodagent-dev-secret-change-me
JWT_EXPIRE_MINUTES=120

# ---------- 后厨调度 ----------
KITCHEN_INTERRUPT_THRESHOLD=10
KITCHEN_STATIONS=凉菜间,热菜间,面点间,出菜口

# ---------- 食品安全合规 ----------
COMPLIANCE_LOG_YEARS=3

# ---------- 运行策略：远程模型最小验证 ----------
# 对话模型是 DeepSeek 远程 API（非本地部署、按 token 计费），
# 默认禁止跑完整一轮全量流程，只做最小限度验证（硬限制见 base/run_policy.py）。
# 放开全量：ALLOW_FULL_RUN=1 + 命令行 --allow-full（两道闸门缺一不可）
ALLOW_FULL_RUN=0
SMOKE_MAX_SAMPLES=2
SMOKE_MAX_LLM_CALLS=6
